{
  "mcpServers": {
    "qudag": {
      "command": "qudag",
      "args": [
        "mcp",
        "start",
        "--transport",
        "stdio"
      ],
      "alwaysAllow": [
        "qudag_exchange",
        "vault",
        "crypto",
        "config",
        "dag",
        "network",
        "system"
      ],
      "timeout": 600
    },
    "qudag-testnet": {
      "_comment": "Real QuDAG MCP Implementation - Live on fly.dev",
      "command": "node",
      "args": [
        "/workspaces/QuDAG/.roo/mcp-http-proxy.js",
        "https://quadag-mcp.fly.dev"
      ],
      "alwaysAllow": [
        "qudag_crypto",
        "qudag_vault",
        "qudag_dag",
        "qudag_network",
        "qudag_exchange",
        "qudag_dark",
        "qudag_system"
      ],
      "description": "QuDAG Real MCP Server - Full Implementation",
      "timeout": 600,
      "_urls": {
        "primary": "https://quadag-mcp.fly.dev/mcp",
        "tools": "https://quadag-mcp.fly.dev/mcp/tools",
        "health": "https://quadag-mcp.fly.dev/health"
      }
    },
    "qudag-mcp-real": {
      "_comment": "Direct connection to QuDAG Real MCP Implementation",
      "command": "node",
      "args": [
        "/workspaces/QuDAG/.roo/mcp-http-proxy.js",
        "https://quadag-mcp.fly.dev"
      ],
      "alwaysAllow": [
        "qudag_crypto",
        "qudag_vault",
        "qudag_dag",
        "qudag_network",
        "qudag_exchange",
        "qudag_dark",
        "qudag_system"
      ],
      "description": "QuDAG Real MCP - Direct Connection",
      "timeout": 600
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--access-token",
        "${env:SUPABASE_ACCESS_TOKEN}"
      ],
      "alwaysAllow": [
        "list_tables",
        "execute_sql",
        "listTables",
        "list_projects",
        "list_organizations",
        "get_organization",
        "apply_migration",
        "get_project",
        "execute_query",
        "generate_typescript_types",
        "listProjects"
      ]
    }
  }
}