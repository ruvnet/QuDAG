{
  "_comment": "QuDAG MCP Configurations - See mcp-configs-explained.json for details",
  "_status": "Real MCP implementation deployed and WORKING at quadag-mcp.fly.dev",
  "_deployment": {
    "remote_server": "LIVE at https://quadag-mcp.fly.dev - FULLY FUNCTIONAL",
    "local_server": "Also running on http://localhost:3000",
    "local_docker": "docker run -d -p 3000:3000 qudag-mcp-real:standalone",
    "tools": ["qudag_dag", "qudag_network", "qudag_crypto", "qudag_vault", "qudag_exchange", "qudag_dark", "qudag_system"]
  },
  "mcpServers": {
    "qudag": {
      "command": "qudag",
      "args": [
        "mcp",
        "start",
        "--transport",
        "stdio"
      ],
      "alwaysAllow": [
        "qudag_exchange",
        "vault",
        "crypto",
        "config",
        "dag",
        "network",
        "system"
      ],
      "timeout": 600
    },
    "qudag-local": {
      "_comment": "Local MCP server for testing - run: docker run -p 3000:3000 qudag-mcp-real:standalone",
      "command": "node",
      "args": [
        "/workspaces/QuDAG/.roo/mcp-http-proxy.js",
        "http://localhost:3000"
      ],
      "alwaysAllow": [
        "qudag_crypto",
        "qudag_vault",
        "qudag_dag",
        "qudag_network",
        "qudag_exchange",
        "qudag_dark",
        "qudag_system"
      ],
      "description": "QuDAG Local MCP Server (Docker)",
      "timeout": 600
    },
    "qudag-testnet": {
      "_comment": "Real QuDAG MCP Implementation - Live on fly.dev",
      "command": "node",
      "args": [
        "/workspaces/QuDAG/.roo/mcp-http-proxy.js",
        "https://quadag-mcp.fly.dev"
      ],
      "alwaysAllow": [
        "qudag_crypto",
        "qudag_vault",
        "qudag_dag",
        "qudag_network",
        "qudag_exchange",
        "qudag_dark",
        "qudag_system"
      ],
      "description": "QuDAG Real MCP Server - Full Implementation",
      "timeout": 600,
      "_urls": {
        "primary": "https://quadag-mcp.fly.dev/mcp",
        "tools": "https://quadag-mcp.fly.dev/mcp/tools",
        "health": "https://quadag-mcp.fly.dev/health"
      }
    },
    "qudag-mcp-real": {
      "_comment": "Direct connection to QuDAG Real MCP Implementation",
      "command": "node",
      "args": [
        "/workspaces/QuDAG/.roo/mcp-http-proxy.js",
        "https://quadag-mcp.fly.dev"
      ],
      "alwaysAllow": [
        "qudag_crypto",
        "qudag_vault",
        "qudag_dag",
        "qudag_network",
        "qudag_exchange",
        "qudag_dark",
        "qudag_system"
      ],
      "description": "QuDAG Real MCP - Direct Connection",
      "timeout": 600
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--access-token",
        "${env:SUPABASE_ACCESS_TOKEN}"
      ],
      "alwaysAllow": [
        "list_tables",
        "execute_sql",
        "listTables",
        "list_projects",
        "list_organizations",
        "get_organization",
        "apply_migration",
        "get_project",
        "execute_query",
        "generate_typescript_types",
        "listProjects"
      ]
    }
  }
}