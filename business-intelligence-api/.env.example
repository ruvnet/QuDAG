# QuDAG Business Intelligence API Environment Configuration
# Copy this file to .env and update with your values

# Application
NODE_ENV=development
PORT=8090
HOST=0.0.0.0
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://qudag_executive:password@localhost:5433/qudag_business
DB_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# QuDAG Platform Integration
QUDAG_API_URL=http://localhost:8080
QUDAG_EXCHANGE_URL=http://localhost:8081
QUDAG_WS_URL=ws://localhost:8080/ws
QUDAG_API_KEY=your-qudag-api-key-here

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Metrics Collection
METRICS_INTERVAL=30000
METRICS_RETENTION_DAYS=90

# Feature Flags
ENABLE_PREDICTIVE_ANALYTICS=true
ENABLE_VOICE_COMMANDS=true
ENABLE_AUTO_SCALING=true

# Email Configuration (for reports)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@qudag.ai
SMTP_PASS=your-smtp-password
SMTP_FROM=QuDAG Business Intelligence <notifications@qudag.ai>

# Sentry Error Tracking (optional)
SENTRY_DSN=

# API Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# File Upload Limits
MAX_FILE_SIZE=10485760

# WebSocket Configuration
WS_MAX_PAYLOAD=1048576
WS_HEARTBEAT_INTERVAL=30000

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_ENDPOINT=http://localhost:8090/api/v1/metrics

# Development Settings
DEV_DISABLE_AUTH=false
DEV_LOG_SQL=false
DEV_MOCK_QUDAG=false

# Database Configuration
# Same settings as docker-compose.yml
DB_HOST=localhost
DB_PORT=5433
DB_NAME=qudag_business
DB_USER=qudag_executive
DB_PASSWORD=password123
DB_SSL=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# API Configuration
PORT=8090
NODE_ENV=development
JWT_SECRET=development-secret-key

# External Services
QUDAG_API_URL=http://localhost:8080
QUDAG_EXCHANGE_URL=http://localhost:8081
QUDAG_WS_URL=ws://localhost:8080/ws

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Security
CORS_ORIGIN=*
HELMET_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# ======================================
# PostgreSQL MCP Server Configuration
# ======================================
# Connection string for MCP server
DATABASE_URL=postgresql://qudag_executive:password123@localhost:5433/qudag_business

# Claude Desktop MCP Configuration (copy to Claude Desktop config)
# For Claude Desktop, use this configuration:
# {
#   "mcpServers": {
#     "qudag-postgres": {
#       "command": "npx",
