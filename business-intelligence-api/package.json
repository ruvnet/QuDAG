{
  "name": "qudag-business-intelligence-api",
  "version": "1.0.0",
  "description": "Business Intelligence API for QuDAG Executive Intelligence Center",
  "main": "dist/index-minimal.js",
  "scripts": {
    "dev": "tsx watch src/index-minimal.ts",
    "build": "tsc src/index-minimal.ts --outDir dist --target ES2022 --module commonjs --esModuleInterop --skipLibCheck",
    "build:seed": "tsc src/seed-database.ts --outDir dist --target ES2022 --module commonjs --esModuleInterop --skipLibCheck",
    "seed": "npm run build:seed && node dist/seed-database.js",
    "start": "node dist/index-minimal.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@fastify/websocket": "^9.0.0",
    "ajv": "^8.12.0",
    "axios": "^1.7.2",
    "bullmq": "^5.4.2",
    "date-fns": "^3.3.1",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "ioredis": "^5.3.2",
    "pg": "^8.11.5",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "slonik": "^30.4.4",
    "ws": "^8.17.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "qudag",
    "business-intelligence",
    "api",
    "ai-ceo",
    "executive-dashboard"
  ],
  "author": "QuDAG Team",
  "license": "MIT"
}
