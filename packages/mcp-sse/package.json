{
  "name": "@qudag/mcp-sse",
  "version": "0.1.1",
  "description": "QuDAG MCP server over HTTP (JSON-RPC): ML-KEM-768 key exchange and ML-DSA-65 signing via @qudag/napi-core, OAuth2/JWT auth, RBAC and rate limiting.",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "qudag-mcp-sse": "dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "default": "./dist/middleware/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "start": "node dist/server.js",
    "test": "npm run build && node --test tests/http.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "qudag",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "json-rpc",
    "http",
    "oauth2",
    "post-quantum",
    "ml-kem",
    "ml-dsa",
    "dag"
  ],
  "author": "rUv <ruv@ruv.net>",
  "license": "MIT",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/QuDAG.git",
    "directory": "packages/mcp-sse"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/QuDAG/issues"
  },
  "dependencies": {
    "@qudag/napi-core": "0.1.1",
    "axios": "^1.21.1",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ]
}
