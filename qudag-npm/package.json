{
  "name": "qudag",
  "version": "1.2.4",
  "description": "QuDAG CLI for Node.js: installs the native qudag binary (checksum-verified) for a quantum-resistant DAG network with ML-KEM, ML-DSA and .dark addresses.",
  "keywords": [
    "qudag",
    "quantum-resistant",
    "post-quantum",
    "ml-kem",
    "ml-dsa",
    "dag",
    "p2p",
    "libp2p",
    "cryptography",
    "dark-addressing",
    "cli",
    "npx"
  ],
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/QuDAG.git",
    "directory": "qudag-npm"
  },
  "license": "MIT OR Apache-2.0",
  "author": "rUv <ruv@ruv.net>",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "qudag": "./bin/qudag.js"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "postinstall": "node dist/install.js",
    "test": "node dist/test.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "fs-extra": "^11.2.0",
    "progress": "^2.0.3",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.0",
    "@types/progress": "^2.0.7",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/QuDAG/issues"
  }
}
