# QuDAG PostgreSQL MCP Server Configuration
# Copy this file to .env and update with your values

# Database Configuration
DATABASE_URL=postgresql://qudag_executive:password@localhost:5433/qudag_business

# MCP Server Settings
MCP_ACCESS_MODE=restricted
MCP_ALLOWED_SCHEMAS=executive
MCP_AUDIT_LOG=true

# Security Settings
REQUIRE_CONFIRMATION_DELETE=true
REQUIRE_CONFIRMATION_ADMIN=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_CONNECTIONS=10

# Query Limits
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_MS=30000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=

# Node Environment
NODE_ENV=development 