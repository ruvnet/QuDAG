# Simplified QuDAG MCP Real Implementation
FROM rust:1.87-slim AS builder

# Install minimal dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Create workspace structure
RUN mkdir -p core/crypto core/dag core/network core/vault

# Copy only necessary files
COPY core/crypto/Cargo.toml core/crypto/
COPY core/dag/Cargo.toml core/dag/
COPY core/network/Cargo.toml core/network/
COPY core/vault/Cargo.toml core/vault/

# Create dummy src files for dependencies
RUN mkdir -p core/crypto/src core/dag/src core/network/src core/vault/src && \
    echo "pub struct CryptoManager; impl CryptoManager { pub fn new() -> Self { Self } pub fn generate_keypair(&self) -> KeyPair { KeyPair } } pub struct KeyPair; impl KeyPair { pub fn public_key(&self) -> Vec<u8> { vec![] } }" > core/crypto/src/lib.rs && \
    echo "pub struct Dag; pub struct DagConfig; impl Default for DagConfig { fn default() -> Self { Self } } impl Dag { pub fn new(_: DagConfig) -> Self { Self } } pub struct VertexId;" > core/dag/src/lib.rs && \
    echo "pub struct NetworkManager; pub struct NetworkConfig; impl Default for NetworkConfig { fn default() -> Self { Self } } impl NetworkManager { pub async fn new(_: NetworkConfig) -> Self { Self } }" > core/network/src/lib.rs && \
    echo "pub struct Vault; pub struct VaultConfig; impl Default for VaultConfig { fn default() -> Self { Self } } impl Vault { pub fn new(_: VaultConfig) -> Self { Self } }" > core/vault/src/lib.rs

# Copy our simplified implementation
COPY qudag-testnet/qudag-mcp-real/Cargo.simple.toml /build/Cargo.toml
COPY qudag-testnet/qudag-mcp-real/src/main_simple.rs /build/src/main.rs

# Build
RUN cargo build --release

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/qudag-mcp-real-simple /usr/local/bin/qudag-mcp-real

# Expose ports
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

# Run
ENV RUST_LOG=info
CMD ["qudag-mcp-real"]